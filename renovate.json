{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main", "/^release-\\d+\\.\\d+$/"],
  "prConcurrentLimit": 3,
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpdateOptions": ["gomodTidy"],
  "labels": ["release-note-none"],
  "extends": [":gitSignOff", ":dependencyDashboard"],
  "packageRules": [
    {
      "description": "Enable indirect Go dependency updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Group Go digest, patch, and minor updates",
      "matchManagers": ["gomod"],
      "groupName": "all dependencies",
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "enabled": true
    },
    {
      "description": "Group direct major Go updates and rewrite import paths",
      "matchManagers": ["gomod"],
      "groupName": "major dependencies",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["require"],
      "enabled": true,
      "postUpdateOptions": ["gomodUpdateImportPaths"]
    },
    {
      "description": "Disable updates for packages that currently require code changes",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/{/,}**",
        "sigs.k8s.io/{/,}**"
      ],
      "enabled": false
    },
    {
      "description": "Disable major indirect Go updates",
      "matchManagers": ["gomod"],
      "groupName": "ignore",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["indirect"],
      "enabled": false
    },
    {
      "description": "Disable routine updates on release branches; vulnerability alerts override this",
      "matchManagers": ["gomod"],
      "matchBaseBranches": ["/^release-\\d+\\.\\d+$/"],
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ],
  "postUpgradeTasks": {
    "commands": ["make vendor", "make fmt", "make generate", "make manifests", "make vendor"],
    "executionMode": "branch",
    "installTools": {
      "golang": {}
    }
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "separateMajorMinor": true,
  "ignorePaths": ["**/vendor/**"]
}
